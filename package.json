{
  "name": "pokemon-wildbound",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "start": "vite --host localhost --port 5173 --strictPort --open",
    "dev": "vite --host 0.0.0.0",
    "build": "tsc --noEmit && vite build",
    "test": "tsx --test tests/*.test.ts",
    "preview": "vite preview --host 0.0.0.0",
    "format": "prettier --write src tests index.html package.json tsconfig.json README.md",
    "format:check": "prettier --check src tests index.html package.json tsconfig.json README.md"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "prettier": "^3.9.9",
    "tsx": "^4.20.0",
    "typescript": "~5.9.0",
    "vite": "^7.1.0"
  },
  "engines": {
    "node": ">=24"
  }
}
